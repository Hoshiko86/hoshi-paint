export enum FileAction { open, save, save-as, save-all, close, close-all, exit, new }

export component FileShortcuts inherits FocusScope {
    init => { self.focus(); }
    callback file-action(FileAction);
    callback cycle-document(bool);
    key-pressed(event) => {
        if event.modifiers.control || event.modifiers.meta {
            if event.text == "o" || event.text == "O" { root.file-action(FileAction.open); return accept; }
            if event.text == "s" || event.text == "S" { root.file-action(event.modifiers.alt ? FileAction.save-all : event.modifiers.shift ? FileAction.save-as : FileAction.save); return accept; }
            if event.text == "w" || event.text == "W" { root.file-action(event.modifiers.shift ? FileAction.close-all : FileAction.close); return accept; }
            if event.text == "n" || event.text == "N" { root.file-action(FileAction.new); return accept; }
            if event.text == Key.Tab { root.cycle-document(event.modifiers.shift); return accept; }
        }
        reject
    }
}
