import { Button } from "std-widgets.slint";
import { DesktopTheme } from "theme.slint";
import { Translations } from "localization.slint";

// Drawing commands and shared brush size; editing policy stays in the controller.
export component DrawingTools inherits VerticalLayout {
    in property <string> selected-tool;
    in property <bool> enabled;
    callback choose-tool(string);
    spacing: 8px;
    for tool in [
        { id: "paintbrush", label: Translations.brush, icon: @image-url("../icons/brush.svg") },
        { id: "eraser", label: Translations.eraser, icon: @image-url("../icons/eraser.svg") },
        { id: "color-picker", label: Translations.eyedropper, icon: @image-url("../icons/pipette.svg") }
    ]: Rectangle {
        height: DesktopTheme.tool-rail-width - 20px;
        border-width: root.selected-tool == tool.id ? 2px : 0px;
        border-color: DesktopTheme.selected-tool;
        border-radius: 4px;
        background: transparent;
        Button {
            x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
            icon: tool.icon;
            accessible-label: tool.label;
            enabled: root.enabled;
            opacity: self.enabled ? 1 : 0.4;
            Tooltip { text: @markdown("\{tool.label}"); }
            clicked => { root.choose-tool(tool.id); }
        }
    }
}
