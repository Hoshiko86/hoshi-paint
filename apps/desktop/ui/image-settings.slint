import { Button, LineEdit, CheckBox, ComboBox, ScrollView } from "std-widgets.slint";
import { DesktopTheme } from "theme.slint";
import { Translations } from "localization.slint";
export enum ImageDialog { closed, new-image, resize, canvas-size }
export enum ImageField { width, height, resolution, percent }

export component ImageSettings inherits Rectangle {
    in property <ImageDialog> kind;
    in-out property <string> width-text;
    in-out property <string> height-text;
    in-out property <string> resolution-text;
    in-out property <string> percent-text;
    in property <int> units;
    in property <bool> aspect;
    in property <bool> percentage;
    in-out property <int> anchor: 4;
    in-out property <int> background-choice;
    in-out property <int> resampling: 0;
    in-out property <bool> gamma-correction: true;
    in property <string> summary;
    in property <string> error;
    callback edited(ImageField, string);
    callback units-selected(int);
    callback aspect-selected(bool);
    callback percentage-selected(bool);
    callback apply();
    callback cancel();
    background: DesktopTheme.panel-background; border-width: 1px; border-color: DesktopTheme.panel-border; border-radius: 8px;
    init => { width-entry.focus(); }
    ScrollView {
        content-width: self.width;
        content-height: root.kind == ImageDialog.new-image ? 610px : root.kind == ImageDialog.resize ? 700px : 680px;
    FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            reject
        }
    VerticalLayout {
        padding: 20px; spacing: 10px;
        Text { text: root.kind == ImageDialog.new-image ? Translations.dialog-new : root.kind == ImageDialog.resize ? Translations.dialog-resize : Translations.dialog-canvas-size; font-size: 22px; font-weight: 700; color: DesktopTheme.text; }
        if root.kind == ImageDialog.resize: HorizontalLayout {
            ComboBox { model: [Translations.size-absolute, Translations.size-percentage]; current-index: root.percentage ? 1 : 0;
                accessible-label: Translations.resize-mode; selected(value) => { root.percentage-selected(self.current-index == 1); } }
            LineEdit { text <=> root.percent-text; enabled: root.percentage; accessible-label: Translations.resize-percentage; edited(value) => { root.edited(ImageField.percent, value); } accepted => { root.apply(); } }
            Text { text: "%"; vertical-alignment: center; color: DesktopTheme.text; }
        }
        HorizontalLayout {
            Text { text: Translations.units; width: 100px; vertical-alignment: center; color: DesktopTheme.text; }
            ComboBox { model: [Translations.unit-name-pixels, Translations.unit-name-inches, Translations.unit-name-centimeters]; current-index: root.units;
                accessible-label: Translations.image-units; selected(value) => { root.units-selected(self.current-index); } }
        }
        HorizontalLayout {
            Text { text: Translations.width; width: 100px; vertical-alignment: center; color: DesktopTheme.text; }
            width-entry := LineEdit { text <=> root.width-text; enabled: !root.percentage; accessible-label: Translations.image-width; edited(value) => { root.edited(ImageField.width, value); } accepted => { root.apply(); } }
        }
        HorizontalLayout {
            Text { text: Translations.height; width: 100px; vertical-alignment: center; color: DesktopTheme.text; }
            LineEdit { text <=> root.height-text; enabled: !root.percentage; accessible-label: Translations.image-height; edited(value) => { root.edited(ImageField.height, value); } accepted => { root.apply(); } }
        }
        CheckBox { text: Translations.maintain-aspect; checked: root.aspect; enabled: !root.percentage;
            toggled => { root.aspect-selected(self.checked); } }
        if root.kind != ImageDialog.canvas-size: HorizontalLayout {
            Text { text: Translations.resolution; width: 100px; vertical-alignment: center; color: DesktopTheme.text; }
            LineEdit { text <=> root.resolution-text; accessible-label: Translations.resolution-label; edited(value) => { root.edited(ImageField.resolution, value); } accepted => { root.apply(); } }
            Text { text: Translations.pixels-per-inch; color: DesktopTheme.text; vertical-alignment: center; }
        }
        if root.kind == ImageDialog.resize: HorizontalLayout {
            Text { text: Translations.resampling; width: 100px; color: DesktopTheme.text; vertical-alignment: center; }
            ComboBox { model: [Translations.resample-bicubic, Translations.resample-bicubic-smooth, Translations.resample-bilinear, Translations.resample-bilinear-low, Translations.resample-adaptive, Translations.resample-lanczos, Translations.resample-fant, Translations.resample-nearest]; current-index <=> root.resampling; accessible-label: Translations.resampling-label; }
            Button { icon: @image-url("../icons/undo-2.svg"); width: 32px; accessible-label: Translations.reset-resampling;
                Tooltip { text: Translations.styled(Translations.reset-resampling); }
                clicked => { root.resampling = 0; } }
        }
        if root.kind == ImageDialog.resize: CheckBox {
            text: Translations.gamma-correction; accessible-label: Translations.gamma-correction;
            checked <=> root.gamma-correction;
            Tooltip { text: Translations.styled(Translations.gamma-tooltip); }
        }
        if root.kind == ImageDialog.canvas-size: HorizontalLayout {
            Text { text: Translations.anchor; width: 100px; color: DesktopTheme.text; vertical-alignment: center; }
            Rectangle { width: 150px; height: 108px;
                for label[index] in [Translations.anchor-top-left, Translations.anchor-top, Translations.anchor-top-right, Translations.anchor-left, Translations.anchor-center, Translations.anchor-right, Translations.anchor-bottom-left, Translations.anchor-bottom, Translations.anchor-bottom-right]: Button {
                    x: Math.mod(index, 3) * 50px; y: floor(index / 3) * 36px; width: 46px; height: 32px;
                    text: root.anchor == index ? "●" : ["↖", "↑", "↗", "←", "·", "→", "↙", "↓", "↘"][index];
                    accessible-label: Translations.canvas-anchor + " " + label; clicked => { root.anchor = index; }
                }
            }
        }
        if root.kind != ImageDialog.resize: HorizontalLayout {
            Text { text: root.kind == ImageDialog.new-image ? Translations.background : Translations.fill-new-area; width: 100px; color: DesktopTheme.text; vertical-alignment: center; }
            ComboBox { model: root.kind == ImageDialog.new-image ? [Translations.background-white, Translations.background-transparent, Translations.background-secondary] : [Translations.background-transparent, Translations.background-secondary];
                current-index <=> root.background-choice; accessible-label: Translations.image-background; }
        }
        Text { text: root.summary; wrap: word-wrap; color: DesktopTheme.muted-text; }
        Text { text: root.error; wrap: word-wrap; color: DesktopTheme.error-text; min-height: 36px; }
        Text { text: root.kind == ImageDialog.new-image ? Translations.new-image-note : Translations.image-edit-note; wrap: word-wrap; color: DesktopTheme.muted-text; font-size: 12px; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            Button { text: Translations.cancel; clicked => { root.cancel(); } }
            Button { text: root.kind == ImageDialog.new-image ? Translations.create : Translations.ok; accessible-label: Translations.apply-image-settings; clicked => { root.apply(); } }
        }
    }
}
}
}
