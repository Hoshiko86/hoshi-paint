// User-facing strings cross the adapter through this global. Rust initializes
// every value from the selected catalog before showing the component tree.
export global Translations {
    in-out property <string> brush;
    in-out property <string> brush-width;
    in-out property <string> eraser;
    // Core errors are codes; their user-facing copy lives in the catalogs.
    in-out property <string> error-history-corrupt;
    in-out property <string> error-history-io;
    in-out property <string> error-memory-limit;
    in-out property <string> eyedropper;
    in-out property <string> screen-picker;
    in-out property <string> locale;
    in-out property <string> tool;
    in-out property <string> rectangle;
    in-out property <string> fill;
    in-out property <string> outline;
    in-out property <string> fill-and-outline;
    in-out property <string> shapes;
    in-out property <string> finish-shape;
    in-out property <string> undo;
    in-out property <string> redo;
    in-out property <string> history;
    in-out property <string> commit-shape;
    in-out property <string> cancel-shape;
    in-out property <string> shape-properties;
    in-out property <string> zoom-out;
    in-out property <string> fit-canvas;
    in-out property <string> reset-view;
    in-out property <string> zoom-in;
    in-out property <string> activate-document;
    in-out property <string> close-document;
    in-out property <string> layer;
    in-out property <string> layer-name;
    in-out property <string> unit-pixels;
    in-out property <string> key-commit;
    in-out property <string> key-cancel;
    in-out property <string> shortcut-undo;
    in-out property <string> shortcut-redo;
    in-out property <string> save-changes-title;
    in-out property <string> save-changes-prefix;
    in-out property <string> save-changes-suffix;
    in-out property <string> unsaved-changes-warning;
    in-out property <string> save;
    in-out property <string> dont-save;
    in-out property <string> cancel;
    in-out property <string> save-before-closing;
    in-out property <string> discard-and-close;
    in-out property <string> cancel-closing-document;
    in-out property <string> save-configuration;
    in-out property <string> jpeg-quality;
    in-out property <string> save-format-guidance;
    in-out property <string> confirm-format-and-save;
    in-out property <string> file-operation-failed;
    in-out property <string> ok;
    in-out property <string> current-state;
    in-out property <string> redo-available;
}
