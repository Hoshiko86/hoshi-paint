// User-facing strings cross the adapter through this global. English defaults
// keep design-time previews usable; Rust replaces them from the selected catalog.
export global Translations {
    in-out property <string> locale: "en-US";
    in-out property <string> tool: "Tool:";
    in-out property <string> rectangle: "Rectangle";
    in-out property <string> fill: "Fill";
    in-out property <string> outline: "Outline";
    in-out property <string> fill-and-outline: "Fill + Outline";
    in-out property <string> shapes: "Shapes";
    in-out property <string> finish-shape: "Finish shape";
    in-out property <string> undo: "Undo";
    in-out property <string> redo: "Redo";
    in-out property <string> history: "History";
    in-out property <string> commit-shape: "Commit shape";
    in-out property <string> cancel-shape: "Cancel shape";
    in-out property <string> shape-properties: "Shape Properties";
    in-out property <string> zoom-out: "Zoom out";
    in-out property <string> fit-canvas: "Fit canvas in window";
    in-out property <string> reset-view: "Center canvas at 100%";
    in-out property <string> zoom-in: "Zoom in";
    in-out property <string> activate-document: "Activate document";
    in-out property <string> close-document: "Close document";
    in-out property <string> layer: "Layer";
    in-out property <string> layer-name: "Layer name";
}
