import { Button, SpinBox, ScrollView } from "std-widgets.slint";
import { DesktopTheme } from "theme.slint";
import { Translations } from "localization.slint";
export component SavePrompt inherits Rectangle {
    in property <string> name;
    callback response(int);
    background: DesktopTheme.panel-background; border-width: 1px; border-color: DesktopTheme.panel-border; border-radius: 8px;
    FocusScope { width: parent.width; height: parent.height;
        init => { self.focus(); }
        key-pressed(event) => { if event.text == Key.Escape { root.response(2); return accept; } reject }
        VerticalLayout { padding: 20px; spacing: 14px;
            Text { text: Translations.save-changes-title; font-size: 22px; font-weight: 700; color: DesktopTheme.text; }
            Text { text: Translations.save-changes-prefix + "“" + root.name + "”" + Translations.save-changes-suffix; wrap: word-wrap; color: DesktopTheme.text; }
            Text { text: Translations.unsaved-changes-warning; wrap: word-wrap; color: DesktopTheme.muted-text; }
            HorizontalLayout { spacing: 8px;
                Button { text: Translations.save; accessible-label: Translations.save-before-closing; clicked => { root.response(0); } }
                Button { text: Translations.dont-save; accessible-label: Translations.discard-and-close; clicked => { root.response(1); } }
                Button { text: Translations.cancel; accessible-label: Translations.cancel-closing-document; clicked => { root.response(2); } }
            }
        }
    }
}
export component SaveConfiguration inherits Rectangle {
    in property <bool> jpeg;
    in property <string> warning;
    in-out property <int> quality: 95;
    callback save();
    callback cancel();
    background: DesktopTheme.panel-background; border-width: 1px; border-color: DesktopTheme.panel-border; border-radius: 8px;
    FocusScope { width: parent.width; height: parent.height;
        init => { self.focus(); }
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); return accept; } reject }
        VerticalLayout { padding: 20px; spacing: 14px;
            Text { text: Translations.save-configuration; font-size: 22px; font-weight: 700; color: DesktopTheme.text; }
            Text { text: root.warning; wrap: word-wrap; color: DesktopTheme.text; }
            if root.jpeg: HorizontalLayout {
                Text { text: Translations.jpeg-quality; color: DesktopTheme.text; vertical-alignment: center; }
                SpinBox { minimum: 1; maximum: 100; value <=> root.quality; accessible-label: Translations.jpeg-quality; }
            }
            Text { text: Translations.save-format-guidance; wrap: word-wrap; color: DesktopTheme.muted-text; }
            HorizontalLayout { spacing: 8px;
                Button { text: Translations.cancel; clicked => { root.cancel(); } }
                Button { text: Translations.save; accessible-label: Translations.confirm-format-and-save; clicked => { root.save(); } }
            }
        }
    }
}

export component FileErrorPrompt inherits Rectangle {
    in property <string> message;
    callback dismiss();
    background: DesktopTheme.panel-background; border-width: 1px; border-color: DesktopTheme.panel-border; border-radius: 8px;
    FocusScope { width: parent.width; height: parent.height;
        init => { self.focus(); }
        key-pressed(event) => { if event.text == Key.Escape || event.text == Key.Return { root.dismiss(); return accept; } reject }
        VerticalLayout { padding: 20px; spacing: 12px;
            Text { text: Translations.file-operation-failed; font-size: 22px; font-weight: 700; color: DesktopTheme.text; }
            ScrollView { vertical-stretch: 1; content-width: self.visible-width;
                Text { width: parent.width; text: root.message; wrap: word-wrap; color: DesktopTheme.error-text; }
            }
            Button { text: Translations.ok; clicked => { root.dismiss(); } }
        }
    }
}
