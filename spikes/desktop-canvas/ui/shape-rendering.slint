// Rendering settings are shared by every shape tool. The controller owns
// validation, preview updates, and the defaults used for the next gesture.
import { LineEdit, CheckBox } from "std-widgets.slint";

component StyleSample inherits Rectangle {
    in property <bool> fill-preview;
    in property <int> option;
    background: #ffffff;
    border-width: 1px;
    border-color: #aeb8c8;
    border-radius: 2px;
    clip: true;

    if !root.fill-preview: Rectangle {
        x: 5px; y: parent.height / 2 - 1px;
        width: parent.width - 10px; height: 2px;
        background: root.option == 0 ? #273650 : transparent;
        for stroke[index] in 48: Rectangle {
            x: index * 4px; width: 3px; height: 2px;
            background: #273650;
            visible: root.option == 1 ? mod(index,6) < 4
                : root.option == 2 ? mod(index,3) == 0
                : root.option == 3 ? mod(index,8) < 4 || mod(index,8) == 6
                : root.option == 4 ? mod(index,10) < 4 || mod(index,10) == 6 || mod(index,10) == 8
                : false;
        }
    }

    if root.fill-preview && root.option == 0: Rectangle {
        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
        background: #526079;
    }
    if root.fill-preview && (root.option == 1 || root.option == 5): Rectangle {
        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
        for line[index] in 6: Rectangle { y: index * 5px; width: parent.width; height: 1px; background: #526079; }
    }
    if root.fill-preview && (root.option == 2 || root.option == 5): Rectangle {
        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
        for line[index] in 20: Rectangle { x: index * 5px; width: 1px; height: parent.height; background: #526079; }
    }
    if root.fill-preview && (root.option == 3 || root.option == 6): Rectangle {
        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
        Path {
            width: parent.width; height: parent.height; viewbox-width: 100; viewbox-height: 24;
            commands: "M-20 24L4 0 M-8 24L16 0 M4 24L28 0 M16 24L40 0 M28 24L52 0 M40 24L64 0 M52 24L76 0 M64 24L88 0 M76 24L100 0 M88 24L112 0";
            stroke: #526079; stroke-width: 1px; clip: true;
        }
    }
    if root.fill-preview && (root.option == 4 || root.option == 6): Rectangle {
        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
        Path {
            width: parent.width; height: parent.height; viewbox-width: 100; viewbox-height: 24;
            commands: "M-20 0L4 24 M-8 0L16 24 M4 0L28 24 M16 0L40 24 M28 0L52 24 M40 0L64 24 M52 0L76 24 M64 0L88 24 M76 0L100 24 M88 0L112 24";
            stroke: #526079; stroke-width: 1px; clip: true;
        }
    }
    if root.fill-preview && root.option == 7: Rectangle {
        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
        for square[index] in 56: Rectangle {
            x: mod(index,14) * 7px; y: floor(index / 14) * 7px;
            width: 7px; height: 7px;
            background: mod(index + floor(index / 14),2) == 0 ? #526079 : #ffffff;
        }
    }
}

component VisualStyleSelector inherits FocusScope {
    in property <bool> fill-preview;
    in property <int> current-index;
    in property <[string]> names;
    callback selected(int);
    min-height: 34px;
    horizontal-stretch: 1;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: popup.is-open;
    accessible-value: root.names[root.current-index];
    accessible-label: root.fill-preview ? "Shape fill pattern" : "Outline line style";
    accessible-action-expand => { if root.enabled { popup.show(); } }
    key-pressed(event) => {
        if !root.enabled { return reject; }
        if event.text == Key.DownArrow {
            root.selected(min(root.names.length - 1,root.current-index + 1)); return accept;
        }
        if event.text == Key.UpArrow {
            root.selected(max(0,root.current-index - 1)); return accept;
        }
        if event.text == Key.Return || event.text == Key.Space { popup.show(); return accept; }
        return reject;
    }
    Rectangle {
        background: root.enabled ? (touch.has-hover ? #f8faff : #ffffff) : #e8ebf0;
        border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus ? #315cae : #aeb8c8;
        border-radius: 3px;
        StyleSample { x: 8px; y: 5px; width: parent.width - 38px; height: parent.height - 10px;
            fill-preview: root.fill-preview; option: root.current-index; }
        Text { x: parent.width - 25px; width: 18px; height: parent.height;
            text: popup.is-open ? "⌃" : "⌄"; color: #526079;
            horizontal-alignment: center; vertical-alignment: center; }
        touch := TouchArea {
            enabled: root.enabled;
            clicked => { root.focus(); popup.show(); }
        }
        Tooltip { text: @markdown("\{root.names[root.current-index]}"); }
    }
    popup := PopupWindow {
        x: 0px; y: root.height + 2px; width: root.width;
        height: root.names.length * 36px + 8px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: #ffffff; border-width: 1px; border-color: #aeb8c8; border-radius: 3px;
            VerticalLayout {
                padding: 4px; spacing: 0px;
                for name[index] in root.names: Rectangle {
                    height: 36px;
                    accessible-role: button;
                    accessible-label: name;
                    accessible-description: (root.fill-preview ? "Fill pattern: " : "Line style: ") + name;
                    accessible-action-default => { root.selected(index); popup.close(); root.focus(); }
                    background: index == root.current-index ? #dbe8ff : (row-touch.has-hover ? #edf3ff : #ffffff);
                    border-width: index == root.current-index ? 1px : 0px;
                    border-color: #315cae;
                    StyleSample { x: 7px; y: 5px; width: parent.width - 14px; height: 26px;
                        fill-preview: root.fill-preview; option: index; }
                    row-touch := TouchArea {
                        clicked => { root.selected(index); popup.close(); root.focus(); }
                    }
                    Tooltip { text: @markdown("\{name}"); }
                }
            }
        }
    }
}

export component ShapeRendering inherits VerticalLayout {
    in property <float> outline-width: 2;
    in property <bool> outline-enabled;
    in property <bool> fill-enabled;
    in property <bool> antialiasing: true;
    in property <int> line-style;
    in property <int> fill-pattern;
    callback edit-width(float);
    callback select-line(int);
    callback select-fill(int);
    callback toggle-antialiasing(bool);
    out property <float> width-left: width-edit.absolute-position.x / 1px;
    out property <float> width-top: width-edit.absolute-position.y / 1px;
    changed outline-width => { if !width-edit.has-focus { width-edit.text = "" + root.outline-width; } }
    spacing: 5px;
    HorizontalLayout { spacing: 6px;
        Text { text: "Width (px)"; color: #526079; font-size: 12px; vertical-alignment: center; }
        width-edit := LineEdit {
            enabled: root.outline-enabled;
            init => { self.text = "" + root.outline-width; }
            changed has-focus => { if !self.has-focus { self.text = "" + root.outline-width; } }
            input-type: decimal; accessible-label: "Outline width in canvas pixels";
            Tooltip { text: @markdown("0.01–65536 pixels. [ and ] change by 1; Ctrl changes by 5."); }
            edited(value) => {
                if value.is-float() && value.to-float() >= 0.01 && value.to-float() <= 65536 {
                    root.edit-width(value.to-float());
                }
            }
            accepted => { self.text = "" + root.outline-width; }
        }
    }
    VisualStyleSelector {
        enabled: root.outline-enabled; fill-preview: false; current-index: root.line-style;
        names: ["Solid", "Dash", "Dot", "Dash dot", "Dash dot dot"];
        selected(index) => { root.select-line(index); }
    }
    VisualStyleSelector {
        enabled: root.fill-enabled; fill-preview: true; current-index: root.fill-pattern;
        names: ["Solid", "Horizontal", "Vertical", "Forward diagonal", "Backward diagonal", "Cross", "Diagonal cross", "Checkerboard"];
        selected(index) => { root.select-fill(index); }
    }
    CheckBox { enabled: root.outline-enabled || root.fill-enabled; text: "Antialiasing"; checked: root.antialiasing;
        toggled => { root.toggle-antialiasing(self.checked); }
        Tooltip { text: @markdown("Smooth shape edges using partial pixel coverage."); }
    }
}
