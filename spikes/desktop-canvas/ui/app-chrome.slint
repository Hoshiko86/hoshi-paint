import { Button, LineEdit, ScrollView, Palette } from "std-widgets.slint";
import { DesktopTheme } from "theme.slint";
import { Translations } from "localization.slint";

export struct DocumentTabRow {
    id: int,
    title: string,
    detail: string,
    thumbnail: image,
    active: bool,
    dirty: bool,
    generation: int,
}

export component DesktopCommandBars inherits Rectangle {
    in property <bool> has-document;
    in property <bool> has-shape;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> modal-visible;
    in property <int> shape-mode;
    in property <float> stroke-width-pixels;
    callback action(int);
    callback select-shapes();
    callback show-history();
    callback show-shape-properties();
    callback zoom(float);
    callback fit-canvas();

    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            height: 24px; spacing: 6px;
            Text { text: Translations.tool; font-size: 11px; color: DesktopTheme.muted-text; vertical-alignment: center; }
            Button { icon: @image-url("../icons/shapes.svg"); width: DesktopTheme.small-button-size; accessible-label: Translations.shapes; enabled: root.has-document;
                Tooltip { Text { text: Translations.shapes + " · " + Translations.rectangle; color: Palette.foreground; } } clicked => { root.select-shapes(); } }
            Rectangle { width: 1px; background: DesktopTheme.border; }
            Text { text: Translations.rectangle; color: DesktopTheme.text; vertical-alignment: center; }
            Text { text: root.shape-mode == 0 ? Translations.fill : root.shape-mode == 1 ? Translations.outline : Translations.fill-and-outline; color: DesktopTheme.muted-text; vertical-alignment: center; }
            Text { text: "· " + root.stroke-width-pixels + " " + Translations.unit-pixels; color: DesktopTheme.muted-text; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Button { icon: @image-url("../icons/check.svg"); width: DesktopTheme.small-button-size; accessible-label: Translations.finish-shape; enabled: root.has-shape;
                opacity: self.enabled ? 1 : 0.4; Tooltip { Text { text: Translations.finish-shape + " · " + Translations.key-commit; color: Palette.foreground; } } clicked => { root.action(2); } }
        }
        HorizontalLayout {
            height: DesktopTheme.compact-button-size; spacing: 4px;
            Button { icon: @image-url("../icons/undo-2.svg"); width: DesktopTheme.compact-button-size; accessible-label: Translations.undo; enabled: root.can-undo || root.has-shape; opacity: self.enabled ? 1 : 0.4;
                Tooltip { Text { text: Translations.undo + " · " + Translations.shortcut-undo; color: Palette.foreground; } } clicked => { root.action(0); } }
            Button { icon: @image-url("../icons/redo-2.svg"); width: DesktopTheme.compact-button-size; accessible-label: Translations.redo; enabled: root.can-redo && !root.has-shape; opacity: self.enabled ? 1 : 0.4;
                Tooltip { Text { text: Translations.redo + " · " + Translations.shortcut-redo; color: Palette.foreground; } } clicked => { root.action(1); } }
            Button { icon: @image-url("../icons/clock-arrow-left.svg"); width: DesktopTheme.compact-button-size; accessible-label: Translations.history; enabled: root.has-document; opacity: self.enabled ? 1 : 0.4;
                Tooltip { Text { text: Translations.history; color: Palette.foreground; } } clicked => { root.show-history(); } }
            Button { icon: @image-url("../icons/check.svg"); width: DesktopTheme.compact-button-size; accessible-label: Translations.commit-shape; enabled: root.has-shape; opacity: self.enabled ? 1 : 0.4;
                Tooltip { Text { text: Translations.commit-shape + " · " + Translations.key-commit; color: Palette.foreground; } } clicked => { root.action(2); } }
            Button { icon: @image-url("../icons/x.svg"); width: DesktopTheme.compact-button-size; accessible-label: Translations.cancel-shape; enabled: root.has-shape; opacity: self.enabled ? 1 : 0.4;
                Tooltip { Text { text: Translations.cancel-shape + " · " + Translations.key-cancel; color: Palette.foreground; } } clicked => { root.action(3); } }
            Button { icon: @image-url("../icons/sliders-horizontal.svg"); width: DesktopTheme.compact-button-size; accessible-label: Translations.shape-properties; enabled: root.has-document; opacity: self.enabled ? 1 : 0.4;
                Tooltip { Text { text: Translations.shape-properties; color: Palette.foreground; } } clicked => { root.show-shape-properties(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { icon: @image-url("../icons/zoom-out.svg"); width: DesktopTheme.compact-button-size; accessible-label: Translations.zoom-out;
                Tooltip { Text { text: Translations.zoom-out; color: Palette.foreground; } } clicked => { root.zoom(-1); } }
            Button { icon: @image-url("../icons/maximize.svg"); width: DesktopTheme.compact-button-size; enabled: root.has-document && !root.modal-visible; opacity: self.enabled ? 1 : 0.4; accessible-label: Translations.fit-canvas;
                Tooltip { Text { text: Translations.fit-canvas; color: Palette.foreground; } } clicked => { root.fit-canvas(); } }
            Button { icon: @image-url("../icons/crosshair.svg"); width: DesktopTheme.compact-button-size; accessible-label: Translations.reset-view;
                Tooltip { Text { text: Translations.reset-view; color: Palette.foreground; } } clicked => { root.action(4); } }
            Button { icon: @image-url("../icons/zoom-in.svg"); width: DesktopTheme.compact-button-size; accessible-label: Translations.zoom-in;
                Tooltip { Text { text: Translations.zoom-in; color: Palette.foreground; } } clicked => { root.zoom(1); } }
        }
    }
}

export component DocumentTabs inherits ScrollView {
    in property <[DocumentTabRow]> tabs;
    in property <bool> modal-visible;
    callback activate(int);
    callback close(int);
    height: 44px;
    content-height: 40px;
    content-width: max(self.width, root.tabs.length * 184px);
    HorizontalLayout {
        spacing: 6px; alignment: start;
        for tab in root.tabs: Rectangle {
            width: 178px;
            background: tab.active ? DesktopTheme.raised-background : DesktopTheme.tab-background;
            border-width: tab.active ? 2px : 1px;
            border-color: tab.active ? DesktopTheme.accent : DesktopTheme.border;
            border-radius: 2px;
            HorizontalLayout {
                padding: 3px; spacing: 3px;
                Button { text: tab.title + (tab.dirty ? " *" : ""); icon: tab.thumbnail;
                    accessible-label: Translations.activate-document + " " + tab.title; enabled: !root.modal-visible;
                    clicked => { root.activate(tab.id); }
                    Tooltip { Text { text: tab.detail; color: Palette.foreground; } }
                }
                Button { icon: @image-url("../icons/x.svg"); width: 26px; accessible-label: Translations.close-document + " " + tab.title;
                    enabled: !root.modal-visible; clicked => { root.close(tab.id); } }
            }
        }
    }
}

export component DesktopStatusBar inherits HorizontalLayout {
    in property <string> status;
    in property <bool> has-document;
    in property <int> image-width;
    in property <int> image-height;
    in property <float> zoom;
    in property <string> layer-name;
    callback rename(string);
    out property <float> input-left: layer-input.absolute-position.x / 1px;
    out property <float> input-top: layer-input.absolute-position.y / 1px;
    out property <string> edit-text: layer-input.text;
    height: DesktopTheme.status-height;
    spacing: 8px;
    Text { text: root.status; color: DesktopTheme.status-text; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
    Text { text: root.has-document ? root.image-width + " × " + root.image-height + " " + Translations.unit-pixels : ""; color: DesktopTheme.muted-text; font-size: 11px; vertical-alignment: center; }
    Text { text: round(root.zoom * 100) + "%"; color: DesktopTheme.text; font-size: 11px; vertical-alignment: center; }
    Text { text: Translations.layer; color: DesktopTheme.muted-text; font-size: 11px; vertical-alignment: center; }
    layer-input := LineEdit { width: 140px; enabled: root.has-document; text: root.layer-name; accessible-label: Translations.layer-name;
        edited(value) => { root.rename(value); self.text = root.layer-name; } }
}
