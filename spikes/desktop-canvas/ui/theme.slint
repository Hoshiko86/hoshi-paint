// Semantic desktop design tokens. Components depend on these roles instead of
// repeating literal colors and dimensions.
export global DesktopTheme {
    out property <color> window-background: #202226;
    out property <color> workspace-background: #36393d;
    out property <color> pasteboard-background: #4a4d52;
    out property <color> panel-background: #303338;
    out property <color> raised-background: #3b4657;
    out property <color> tab-background: #2a2d32;
    out property <color> border: #555b65;
    out property <color> strong-border: #191b1e;
    out property <color> accent: #72a7f8;
    out property <color> selected-tool: #315cae;
    out property <color> text: #e8edf5;
    out property <color> muted-text: #aeb8c8;
    out property <color> subtle-text: #9fa9b8;
    out property <length> compact-button-size: 34px;
    out property <length> small-button-size: 28px;
    out property <length> tool-rail-width: 64px;
    out property <length> status-height: 28px;
}
