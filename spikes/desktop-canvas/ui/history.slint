import { FileShortcuts } from "file-shortcuts.slint";
import { Button, ListView, Palette } from "std-widgets.slint";
import { ToolPanelFrame } from "colors.slint";
export struct HistoryRow { label: string, index: int, current: bool, redo: bool }
export component HistoryPanel inherits Rectangle {
    in property <[HistoryRow]> rows;
    in property <int> current-index;
    function reveal-current() { entries.content-y = -max(0px,(root.current-index + 1) * 34px - entries.visible-height); }
    init => { root.reveal-current(); }
    changed current-index => { root.reveal-current(); }
    in property <bool> can-jump;
    in property <string> status-text;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> has-shape;
    in property <int> placement;
    callback placement-selected(int);
    callback close-panel();
    callback jump(int);
    callback undo();
    callback redo();
    ToolPanelFrame {
        title: "History"; placement: root.placement; docked: root.placement != 0; body-height: 400px;
        placement-selected(value) => { root.placement-selected(value); }
        toggle-dock => { root.placement-selected(root.placement == 0 ? 2 : 0); }
        close-panel => { root.close-panel(); }
        VerticalLayout {
            padding: 8px; spacing: 8px;
            HorizontalLayout {
                alignment: start; spacing: 8px;
                Button { icon: @image-url("../icons/undo-2.svg"); width: 40px; enabled: root.can-undo; opacity: self.enabled ? 1 : 0.4; accessible-label: "Undo";
                    Tooltip { text: @markdown("Undo · Ctrl/Cmd+Z"); } clicked => { root.undo(); } }
                Button { icon: @image-url("../icons/redo-2.svg"); width: 40px; enabled: root.can-redo; opacity: self.enabled ? 1 : 0.4; accessible-label: "Redo";
                    Tooltip { text: @markdown("Redo · Ctrl/Cmd+Shift+Z"); } clicked => { root.redo(); } }
            }
            Text { text: root.status-text; wrap: word-wrap; color: #526079; min-height: 56px; vertical-stretch: 0; }
            entries := ListView {
                min-height: 40px; vertical-stretch: 1;
                content-height: root.rows.length * 34px;
                changed visible-height => { root.reveal-current(); }
                for row in root.rows : Rectangle {
                    height: 34px;
                    border-width: row.current ? 2px : 0px;
                    border-color: #315cae;
                    Button {
                        x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
                        text: (row.current ? "● " : row.redo ? "↷ " : "") + row.label;
                        enabled: root.can-jump;
                        opacity: row.redo ? 0.55 : 1;
                        accessible-label: row.label + (row.current ? " · current state" : row.redo ? " · redo available" : "");
                        clicked => { root.jump(row.index); }
                    }
                }
            }
        }
    }
}
export component HistoryWindow inherits Window {
    callback file-action(int);
    callback cycle-document(bool);
    title: "History · Hoshi Paint";
    preferred-width: 340px; preferred-height: 520px;
    min-width: 300px; min-height: 250px;
    background: #f2f4f8; default-font-size: 13px;
    init => { Palette.color-scheme = ColorScheme.light; }
    in property <[HistoryRow]> rows <=> panel.rows;
    in property <int> current-index <=> panel.current-index;
    in property <bool> can-jump <=> panel.can-jump;
    in property <string> status-text <=> panel.status-text;
    in property <bool> can-undo <=> panel.can-undo;
    in property <bool> can-redo <=> panel.can-redo;
    in property <bool> has-shape <=> panel.has-shape;
    in property <int> placement <=> panel.placement;
    callback placement-selected(int);
    callback close-panel();
    callback jump(int);
    callback undo();
    callback redo();
    FileShortcuts {
        width: parent.width; height: parent.height;
        file-action(value) => { root.file-action(value); }
        cycle-document(backward) => { root.cycle-document(backward); }
    panel := HistoryPanel {
        placement-selected(value) => { root.placement-selected(value); }
        close-panel => { root.close-panel(); }
        jump(index) => { root.jump(index); }
        undo => { root.undo(); }
        redo => { root.redo(); }
    }
    }
}
